# Copie este arquivo para .env.local e preencha os valores necessários.

# URL pública de produção do site (sem barra no final), usada para resolver URLs absolutas
# de metadata (Open Graph, Twitter Card, canonical). Em desenvolvimento local pode ficar em
# branco — cai automaticamente para http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Supabase — arquitetura preparada (lib/supabase/), ainda NÃO conectado. Nada no código chama
# lib/supabase/client.ts ou server.ts hoje, então deixar em branco não quebra nada. Preencha só
# quando um projeto Supabase real existir e a integração for de fato ligada.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
