# Copie este arquivo para .env.local e preencha os valores necessários.

# URL pública de produção do site (sem barra no final), usada para resolver URLs absolutas
# de metadata (Open Graph, Twitter Card, canonical). Em desenvolvimento local pode ficar em
# branco — cai automaticamente para http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Supabase — CONECTADO de verdade desde o Procreating OS (auth, `lib/supabase/server.ts`, todo o
# banco do ERP interno). Nota desatualizada corrigida: preencher é obrigatório pra rodar o app
# localmente hoje, não mais opcional (era assim numa fase anterior do projeto, antes do ERP).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare R2 — arquitetura preparada (lib/storage/), ainda NÃO conectado. Sem esta variável,
# lib/storage/mock-provider.ts cai num placeholder óbvio (/mock-storage/...) em vez de montar
# uma URL real. Preencha só quando o upload via admin for de fato ligado ao R2.
# Não confundir com o bucket já em produção usado por data/pascoal/videos.ts (esse continua
# com sua URL própria, sem env var — ver docs/r2.md).
R2_PUBLIC_BASE_URL=

# Anthropic (Claude API) — terreno preparado pra IA contextual do Procreating OS (master prompt
# §73-74: "Prioritize my prospects", "Which deals are at risk?" etc.), AINDA NÃO CONECTADO. Nada
# no código chama esta variável hoje — deixar em branco não quebra nada. Decisão já tomada
# (Anthropic/Claude API), mas o orquestrador de IA em si não foi escrito ainda: depende de RBAC
# real existir primeiro (`users.role` hoje não tem enforcement nenhum — IA com acesso a dado
# sensível sem controle de permissão real seria construir em cima de uma base que ainda falta).
ANTHROPIC_API_KEY=
